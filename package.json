{
  "name": "isolated-tech-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy": "vinext deploy",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:migrations": "./scripts/test-migrations.sh",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile tests/e2e/visual/",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-mobile tests/e2e/visual/ --update-snapshots",
    "screenshots:client-work": "node scripts/capture-client-work-screenshots.mjs",
    "test:all": "npm run test:run && npm run test:e2e",
    "typecheck": "tsc --noEmit && tsc --project cli/tsconfig.typecheck.json"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.3.3",
    "better-auth": "^1.4.19",
    "kysely": "^0.28.11",
    "kysely-d1": "^0.4.0",
    "satori": "^0.19.2",
    "stripe": "^20.4.0",
    "vinext": "^0.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@cloudflare/workers-types": "^4.20260304.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-rsc": "^0.5.20",
    "@vitest/coverage-v8": "^4.0.18",
    "next": "^16.2.1",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.68.1"
  }
}
